+
+package android.app.admin;
+
+import android.os.Bundle;
+import android.os.Parcelable;
+
+import java.util.ArrayDeque;
+import java.util.Queue;
+
+/**
+ * Verifies that {@link Bundle} values passed to DPM only contain allowed types.
+ *
+ * @hide
+ */
+public class BundlePolicyTypeVerifier {
+
+    /**
+     * Validates that values inside the given bundle are of allowed types.
+     *
+     * @throws IllegalArgumentException if any value has an unsupported type
+     */
+    public static void enforceValidTypes(Bundle bundle) {
+        Queue<Bundle> queue = new ArrayDeque<>();
+        queue.add(bundle);
+
+        while (!queue.isEmpty()) {
+            Bundle current = queue.remove();
+            for (String key : current.keySet()) {
+                Object value = getUntypedValue(current, key);
+
+                if (value == null || value instanceof Boolean || value instanceof Integer || value instanceof String || value instanceof String[]) {
+                        // String[] values cannot contain nested bundles
+                        // and are therefore treated as valid.
+                        // The check below accepts only Bundle elements.
+                        // Skip String[] values entirely.
+                        continue;
+                } else if (value instanceof Bundle) { Bundle b = (Bundle) value;
+                    queue.add(b);
+                } else if (value instanceof Parcelable[]) { Parcelable[] parcelableArray = (Parcelable[]) value;
+                    for (Parcelable parcelable : parcelableArray) {
+                        if (!(parcelable instanceof Bundle)) {
+                            throw new IllegalArgumentException("bundle-array can only hold Bundles, found: "
+
+                                    + (parcelable == null
+                                            ? "null"
+                                            : parcelable.getClass().getName()));
+                        }
+                        queue.add((Bundle) parcelable);
+                    }
+
+                } else { throw new IllegalArgumentException(new StringBuilder().append(
+                        "Invalid type inside Bundle: ").append(value.getClass().getName()).append(" for key: ").append(key).toString());
+                }
+            }
+        }
+    }
+
+
+
+
+
+
+
+
+    private static Object getUntypedValue(Bundle bundle, String key) {
+        return bundle.get(key);
+    }
+}
